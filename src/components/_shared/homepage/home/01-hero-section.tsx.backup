}

// Component
const HeroSection: React.FC = () => {
  const { websiteSubCategory } = useWebsiteSubCategory();
  const [isConsultationDialogOpen, setIsConsultationDialogOpen] =
    useState(false);

  // Get dynamic colors
    const pathname = usePathname();

  // Get dynamic colors
  const isMainLandingPage = pathname === '/';
  const mainColor = isMainLandingPage
    ? '#0091FF'
    : (websiteSubCategory?.main_color ?? '#0091FF');
  const secondaryColor = isMainLandingPage
    ? '#5aa4dd'
    : (websiteSubCategory?.secondary_color ?? '#5aa4dd');

  // Handle consultation dialog open
  const handleConsultationClick = () => {
    setIsConsultationDialogOpen(true);
  };

  const handleContactSelect = (contactType: string) => {
    console.log(`📊 Contact selected from hero: ${contactType}`);
  };

  return (
    <>
      <div
        id="hero"
        className="relative min-h-screen w-full overflow-hidden pt-16 md:pt-20"
      >
        {/* Background Image */}
        <div className="absolute inset-0 z-0">
          <Image
            src={HeroBgWeb}
            alt="ALLPRINTS Hero Background"
            fill
            priority
            quality={95}
            className="object-cover"
          />
        </div>

        {/* Main Content */}
        <div className="relative z-10 mx-auto flex max-w-7xl flex-col items-center px-4 text-center py-12 md:py-20">
          {/* Hero Heading Image */}
          <motion.div
            initial={{ opacity: 0, y: 30 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.8, delay: 0.2 }}
            className="w-full max-w-5xl mb-12"
          >
            <Image
              src={HeroHeadingWeb}
              alt="ALLPRINTS - Satu Akun Untuk SNBT, Mandiri PTN & Kedinasan"
              width={1200}
              height={600}
              priority
              quality={95}
              className="w-full h-auto"
            />
          </motion.div>

          {/* CTA Buttons */}
          <CTASection
            onConsultationClick={handleConsultationClick}
            mainColor={mainColor}
            secondaryColor={secondaryColor}
          />
        </div>
      </div>

      {/* Consultation Dialog dengan lazy loading */}
      {isConsultationDialogOpen && (
        <Suspense fallback={null}>
          <ConsultationDialog
            isOpen={isConsultationDialogOpen}
            onOpenChange={setIsConsultationDialogOpen}
            onContactSelect={handleContactSelect}
            showStats={true}
            showDiscordOption={false}
          />
        </Suspense>
      )}
    </>
  );
};

